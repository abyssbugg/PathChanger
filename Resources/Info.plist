	<!-- Sparkle Auto-Update Configuration -->
	<!--                                                                     -->
	<!-- The upstream SUFeedURL (abyssbugg/PathChanger/.../appcast.xml) and  -->
	<!-- SUPublicEDKey were removed in Milestone 5 as stale upstream         -->
	<!-- identifiers. Auto-updates remain disabled until the new maintainer  -->
	<!-- publishes an appcast URL and a paired Ed25519 public key. Sparkle   -->
	<!-- infrastructure (UpdaterController, dependency, build glue) is kept  -->
	<!-- so re-enabling auto-updates only requires re-adding these two keys  -->
	<!-- below and restoring the "Check for Updates…" menu item.             -->
	<key>SUEnableAutomaticChecks</key>
	<false/>
</dict>
</plist>
